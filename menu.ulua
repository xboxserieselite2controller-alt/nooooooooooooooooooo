logo.Name = "Logo"
logo.Size = UDim2.new(0, 70, 0, 70)
logo.Position = UDim2.new(0.5, -35, 0, 8)
logo.BackgroundTransparency = 1
logo.Image = "rbxassetid://113479677268928"
logo.ScaleType = Enum.ScaleType.Fit
logo.Parent = sidebar

-- Sidebar buttons
local categories = {"Player", "Settings", "Menu Settings"}
local catButtons = {}
local currentPage = "Player"
local setPage -- defined below, once the pages exist

local yOffset = 90
for _, name in ipairs(categories) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 30)
	btn.Position = UDim2.new(0, 5, 0, yOffset)
	btn.BackgroundColor3 = sideColor()
	btn.BorderSizePixel = 0
	btn.Text = "  " .. name
	btn.TextColor3 = Color3.fromRGB(220, 220, 220)
	btn.TextSize = 14
	btn.Font = Enum.Font.Gotham
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.AutoButtonColor = false
	btn.Parent = sidebar

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 4)
	btnCorner.Parent = btn

	catButtons[name] = btn
	btn.MouseButton1Click:Connect(function()
		setPage(name)
	end)

	yOffset = yOffset + 36
end

--// Content Area
local content = Instance.new("Frame")
content.Size = UDim2.new(1, -145, 1, -10)
content.Position = UDim2.new(0, 140, 0, 5)
content.BackgroundTransparency = 1
content.Parent = main

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "PLAYER"
title.TextColor3 = accent
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = content

-- Pages (one frame per sidebar option)
local function makePage()
	local page = Instance.new("Frame")
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = content
	return page
end

local pages = {
	["Player"] = makePage(),
	["Settings"] = makePage(),
	["Menu Settings"] = makePage(),
}
pages["Player"].Visible = true

setPage = function(name)
	currentPage = name
	for pageName, page in pairs(pages) do
		page.Visible = (pageName == name)
	end
	for btnName, btn in pairs(catButtons) do
		btn.BackgroundColor3 = (btnName == name) and accent or sideColor()
	end
	title.Text = string.upper(name)
end

local playerPage = pages["Player"]

