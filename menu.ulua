-- LocalScript (place in StarterPlayerScripts)

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--// Theme (changed live from the Menu Settings page)
local accent = Color3.fromRGB(220, 50, 50)
local bgColor = Color3.fromRGB(18, 18, 22)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local function sideColor() return bgColor:Lerp(BLACK, 0.3) end
local function fieldColor() return bgColor:Lerp(WHITE, 0.1) end

--// Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CustomMenu"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

--// Main Frame (bigger: 460 x 380)
local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.new(0, 460, 0, 380)
main.Position = UDim2.new(0.5, -230, 0.5, -190)
main.BackgroundColor3 = bgColor
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
main.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = main

local stroke = Instance.new("UIStroke")
stroke.Color = accent
stroke.Thickness = 1.5
stroke.Parent = main

--// Left Sidebar
local sidebar = Instance.new("Frame")
sidebar.Size = UDim2.new(0, 135, 1, 0)
sidebar.BackgroundColor3 = sideColor()
sidebar.BorderSizePixel = 0
sidebar.Parent = main

local sideCorner = Instance.new("UICorner")
