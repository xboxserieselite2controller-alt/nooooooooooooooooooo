local clickDragging = false
local minCPS = 1
local maxCPS = 60

local function updateClickSlider(value)
	value = math.clamp(value, minCPS, maxCPS)
	clickCPS = math.floor(value + 0.5)
	local percent = (clickCPS - minCPS) / (maxCPS - minCPS)
	clickFill.Size = UDim2.new(percent, 0, 1, 0)
	clickThumb.Position = UDim2.new(percent, -8, 0.5, -8)
	if clickCPS >= maxCPS then
		clickSliderLabel.Text = "Clicks per second: MAX (every frame)"
	else
		clickSliderLabel.Text = "Clicks per second: " .. clickCPS
	end
end

updateClickSlider(60)

local function clickSliderFromMouse()
	local mousePos = UserInputService:GetMouseLocation()
	local relative = math.clamp((mousePos.X - clickTrack.AbsolutePosition.X) / clickTrack.AbsoluteSize.X, 0, 1)
	updateClickSlider(minCPS + (maxCPS - minCPS) * relative)
end

