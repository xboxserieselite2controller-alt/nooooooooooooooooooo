thumbCorner.CornerRadius = UDim.new(1, 0)
thumbCorner.Parent = thumb

local dragging = false
local minSpeed = 16
local maxSpeed = 100

local function updateSlider(value)
	value = math.clamp(value, minSpeed, maxSpeed)
	currentSpeed = math.floor(value)
	local percent = (currentSpeed - minSpeed) / (maxSpeed - minSpeed)
	fill.Size = UDim2.new(percent, 0, 1, 0)
	thumb.Position = UDim2.new(percent, -8, 0.5, -8)
	sliderLabel.Text = "Speed: " .. currentSpeed
end

updateSlider(32)

local function sliderFromMouse()
	local mousePos = UserInputService:GetMouseLocation()
	local relative = math.clamp((mousePos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
	updateSlider(minSpeed + (maxSpeed - minSpeed) * relative)
end

thumb.MouseButton1Down:Connect(function()
	dragging = true
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		sliderFromMouse()
	end
end)

track.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		sliderFromMouse()
	end
end)

RunService.Heartbeat:Connect(function()
	if speedEnabled then
		local character = player.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = currentSpeed
			end
		end
	end
end)

local function setSpeedState(state)
	speedEnabled = state
	speedCheck.BackgroundColor3 = speedEnabled and accent or fieldColor()
	if not speedEnabled then
		local character = player.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = normalSpeed
			end
		end
	end
end

speedCheck.MouseButton1Click:Connect(function()
	setSpeedState(not speedEnabled)
end)

keybindBtn.MouseButton1Click:Connect(function()
	waitingForKey = true
	keybindBtn.Text = "..."
	keybindBtn.BackgroundColor3 = accent:Lerp(BLACK, 0.6)
end)

