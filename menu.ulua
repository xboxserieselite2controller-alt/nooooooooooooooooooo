	end
end)

UserInputService.InputChanged:Connect(function(input)
	if clickDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		clickSliderFromMouse()
	end
end)

clickTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		clickSliderFromMouse()
	end
end)

local mouse = player:GetMouse()
local function mouseOverMenu()
	if not main.Visible then return false end
	local pos, size = main.AbsolutePosition, main.AbsoluteSize
	return mouse.X >= pos.X and mouse.X <= pos.X + size.X
		and mouse.Y >= pos.Y and mouse.Y <= pos.Y + size.Y
end

RunService.Heartbeat:Connect(function(dt)
	local holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	if not clickEnabled or not holding or mouseOverMenu() then
		clickTimer = 0
		return
	end
	clickTimer = clickTimer + dt
	if clickCPS >= maxCPS or clickTimer >= 1 / clickCPS then
		clickTimer = 0
		local character = player.Character
		local tool = character and character:FindFirstChildOfClass("Tool")
		if tool then
			tool:Activate()
		end
	end
end)

local function setClickState(state)
	clickEnabled = state
	clickCheck.BackgroundColor3 = clickEnabled and accent or fieldColor()
end

clickCheck.MouseButton1Click:Connect(function()
	setClickState(not clickEnabled)
end)

clickKeyBtn.MouseButton1Click:Connect(function()
	waitingForClickKey = true
	clickKeyBtn.Text = "..."
	clickKeyBtn.BackgroundColor3 = accent:Lerp(BLACK, 0.6)
end)

