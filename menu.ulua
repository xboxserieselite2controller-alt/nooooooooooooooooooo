local function setCamLockState(state)
	camLockEnabled = state
	camLockCheck.BackgroundColor3 = camLockEnabled and accent or fieldColor()
	if camLockEnabled then
		-- Snap the current camera CFrame as the lock target
		lockedCFrame = workspace.CurrentCamera.CFrame
		workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	else
		lockedCFrame = nil
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	end
end

camLockCheck.MouseButton1Click:Connect(function()
	setCamLockState(not camLockEnabled)
end)

camLockKeyBtn.MouseButton1Click:Connect(function()
	waitingForCamLockKey = true
	camLockKeyBtn.Text = "..."
	camLockKeyBtn.BackgroundColor3 = accent:Lerp(BLACK, 0.6)
end)

-- Hold the camera in place every frame while locked
RunService.RenderStepped:Connect(function()
	if camLockEnabled and lockedCFrame then
		workspace.CurrentCamera.CFrame = lockedCFrame
	end
end)

-- ========== MENU SETTINGS PAGE ==========
local menuPage = pages["Menu Settings"]

local function applyAccent(color)
	accent = color
	title.TextColor3 = color
	stroke.Color = color
	fill.BackgroundColor3 = color
	clickFill.BackgroundColor3 = color
	if speedEnabled then speedCheck.BackgroundColor3 = color end
	if clickEnabled then clickCheck.BackgroundColor3 = color end
	if flyEnabled then flyCheck.BackgroundColor3 = color end
	if camLockEnabled then camLockCheck.BackgroundColor3 = color end
	catButtons[currentPage].BackgroundColor3 = color
end

local function applyBackground(color)
	bgColor = color
	main.BackgroundColor3 = color
	sidebar.BackgroundColor3 = sideColor()
	for name, btn in pairs(catButtons) do
		if name ~= currentPage then
			btn.BackgroundColor3 = sideColor()
		end
	end
	if not speedEnabled then speedCheck.BackgroundColor3 = fieldColor() end
	if not waitingForKey then keybindBtn.BackgroundColor3 = fieldColor() end
	track.BackgroundColor3 = fieldColor()
	clickTrack.BackgroundColor3 = fieldColor()
	if not clickEnabled then clickCheck.BackgroundColor3 = fieldColor() end
	if not waitingForClickKey then clickKeyBtn.BackgroundColor3 = fieldColor() end
	if not flyEnabled then flyCheck.BackgroundColor3 = fieldColor() end
	if not waitingForFlyKey then flyKeyBtn.BackgroundColor3 = fieldColor() end
	if not camLockEnabled then camLockCheck.BackgroundColor3 = fieldColor() end
	if not waitingForCamLockKey then camLockKeyBtn.BackgroundColor3 = fieldColor() end
end

local function makeSectionLabel(text, y)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -10, 0, 20)
	label.Position = UDim2.new(0, 0, 0, y)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(200, 200, 205)
	label.TextSize = 14
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = menuPage
end

local function makeSwatchRow(y, colors, defaultIndex, onPick)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -10, 0, 34)
	row.Position = UDim2.new(0, 0, 0, y)
	row.BackgroundTransparency = 1
	row.Parent = menuPage

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 8)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = row

	local rings = {}
	local function highlight(selected)
		for i, ring in ipairs(rings) do
			ring.Transparency = (i == selected) and 0 or 1
		end
	end

	for i, color in ipairs(colors) do
		local swatch = Instance.new("TextButton")
		swatch.Size = UDim2.new(0, 28, 0, 28)
		swatch.BackgroundColor3 = color
		swatch.BorderSizePixel = 0
		swatch.Text = ""
		swatch.AutoButtonColor = false
		swatch.Parent = row

		local swatchCorner = Instance.new("UICorner")
		swatchCorner.CornerRadius = UDim.new(0, 6)
		swatchCorner.Parent = swatch

		local ring = Instance.new("UIStroke")
		ring.Color = WHITE
		ring.Thickness = 2
		ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ring.Parent = swatch
		rings[i] = ring

		swatch.MouseButton1Click:Connect(function()
			highlight(i)
			onPick(color)
		end)
	end

	highlight(defaultIndex)
end

local accentColors = {
	Color3.fromRGB(220, 50, 50),
	Color3.fromRGB(235, 120, 35),
	Color3.fromRGB(235, 200, 45),
	Color3.fromRGB(55, 200, 95),
	Color3.fromRGB(45, 190, 220),
	Color3.fromRGB(65, 115, 235),
	Color3.fromRGB(150, 75, 230),
	Color3.fromRGB(235, 85, 170),
}

local backgroundColors = {
	Color3.fromRGB(18, 18, 22),
	Color3.fromRGB(6, 6, 8),
	Color3.fromRGB(16, 20, 38),
	Color3.fromRGB(14, 28, 22),
	Color3.fromRGB(34, 14, 18),
	Color3.fromRGB(26, 16, 38),
	Color3.fromRGB(32, 34, 40),
}

makeSectionLabel("Menu Color", 45)
makeSwatchRow(70, accentColors, 1, applyAccent)

makeSectionLabel("Background", 120)
makeSwatchRow(145, backgroundColors, 1, applyBackground)

setPage("Player")

local footer = Instance.new("TextLabel")
footer.Size = UDim2.new(1, 0, 0, 20)
footer.Position = UDim2.new(0, 0, 1, -22)
footer.BackgroundTransparency = 1
footer.Text = "Press K to toggle menu"
footer.TextColor3 = Color3.fromRGB(120, 120, 130)
footer.TextSize = 12
footer.Font = Enum.Font.Gotham
footer.Parent = main

--// Input
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if waitingForCamLockKey and input.UserInputType == Enum.UserInputType.Keyboard then
		camLockKey = input.KeyCode
		camLockKeyBtn.Text = input.KeyCode.Name
		camLockKeyBtn.BackgroundColor3 = fieldColor()
		waitingForCamLockKey = false
		return
	end

	if waitingForFlyKey and input.UserInputType == Enum.UserInputType.Keyboard then
		flyKey = input.KeyCode
		flyKeyBtn.Text = input.KeyCode.Name
		flyKeyBtn.BackgroundColor3 = fieldColor()
		waitingForFlyKey = false
		return
	end

	if waitingForClickKey and input.UserInputType == Enum.UserInputType.Keyboard then
		clickKey = input.KeyCode
		clickKeyBtn.Text = input.KeyCode.Name
		clickKeyBtn.BackgroundColor3 = fieldColor()
		waitingForClickKey = false
		return
	end

	if waitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
		speedKey = input.KeyCode
		keybindBtn.Text = input.KeyCode.Name
		keybindBtn.BackgroundColor3 = fieldColor()
		waitingForKey = false
		return
	end

	if input.KeyCode == Enum.KeyCode.K then
		main.Visible = not main.Visible
	end

	if input.KeyCode == speedKey and not waitingForKey then
		setSpeedState(not speedEnabled)
	end

	if input.KeyCode == clickKey and not waitingForClickKey then
		setClickState(not clickEnabled)
	end

	if input.KeyCode == flyKey and not waitingForFlyKey then
		setFlyState(not flyEnabled)
	end

	if input.KeyCode == camLockKey and not waitingForCamLockKey then
		setCamLockState(not camLockEnabled)
	end
end)

print("Menu loaded — Press K to toggle menu")
